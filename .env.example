# Doxa configuration. Copy to .env — which is gitignored — and fill in.
# Every value here is read by name; none is ever logged.

# --- Models -----------------------------------------------------------------------------------
# Required by the model-backed services: ai.visibility, ai.brand, ai.citations, ai.prompts,
# content.audit, content.brief, content.charts. Every other service runs without it.
LLM_BASE_URL=https://router-api.0g.ai/v1
LLM_MODEL=minimax-m3
MINIMAX_API_KEY=

# The router gates availability PER MODEL, not per account: one model can return
# 403 BALANCE_INSUFFICIENT while others on the same key answer normally. The chain is tried in
# order and the model that actually answered is reported with the result.
LLM_MODEL_CHAIN=minimax-m3,glm-5.2,deepseek-v4-pro,qwen3.7-max,hy3

# --- Receipts ---------------------------------------------------------------------------------
# 64 hex characters. SET THIS IN PRODUCTION. Without it a key is generated into the container
# filesystem, so every redeploy and every extra replica signs under a different identity — and
# receipts stop being attributable to Doxa at all.
DOXA_SIGNING_KEY_HEX=

# --- x402 settlement, OKX X Layer -------------------------------------------------------------
# A real X Layer receive wallet. Must be set before submitting the listing for review.
DOXA_PAYTO=
# The public https base URL the ASP is registered under; it becomes resource.url in the challenge.
DOXA_PUBLIC_BASE_URL=https://api.doxa.example

# 'signature' for local and staging, 'facilitator' for production settlement.
DOXA_X402_MODE=signature
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=

# Defaults below are correct for X Layer mainnet and rarely need changing.
# DOXA_NETWORK=eip155:196
# DOXA_ASSET=0x779ded0c9e1022225f8e0630b35a9b54be713736
# DOXA_ASSET_DECIMALS=6

# --- Storage ----------------------------------------------------------------------------------
# DOXA_ARTIFACT_DIR=.artifacts
# DOXA_ARTIFACT_TTL=86400
